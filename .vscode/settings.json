{
  // 源码目录只作查阅用。三条 exclude 各管一件事，可以分开取舍：
  //   files.exclude    = 从资源管理器隐藏      ← 现已全部放开（false）
  //   search.exclude   = 全文搜索跳过          ← 保留，搜笔记时不被源码淹没
  //   watcherExclude   = 不占用文件监听句柄    ← 保留，macOS 上这项最影响卡顿
  //
  // 想重新隐藏某个库：把下面对应那行改回 true 即可。
  "files.exclude": {
    "**/源码/vLLM": false,
    "**/源码/SGLang": false,
    "**/源码/Megatron-LM": false,
    "**/源码/DeepSpeed": false,
    "**/源码/TorchTitan": false,
    "**/源码/VeOmni": false,
    "**/源码/veRL": false
  },
  "search.exclude": {
    "**/源码": true,
    "**/papers": true
  },
  "files.watcherExclude": {
    "**/源码/**": true,
    "**/papers/**": true,
    "**/.git/**": true
  },
  "git.autoRepositoryDetection": false,
  "git.scanRepositories": []
}
